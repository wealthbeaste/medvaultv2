{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://medvaultv2-production.up.railway.app/api/:path*"
    },
    { "source": "/app",             "destination": "/app.html" },
    { "source": "/rx/:code*",       "destination": "/rx-verify.html" },
    { "source": "/order",           "destination": "/order.html" },
    { "source": "/admin",           "destination": "/login.html" },
    { "source": "/ai",              "destination": "/ai.html" },
    { "source": "/suppliers",       "destination": "/suppliers.html" },
    { "source": "/supplier-portal", "destination": "/supplier-portal.html" },
    { "source": "/supplier",        "destination": "/supplier-portal.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",          "value": "DENY" },
        { "key": "X-Content-Type-Options",   "value": "nosniff" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
